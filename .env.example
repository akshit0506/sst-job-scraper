# Copy to .env for local runs. In GitHub Actions, put these as repo secrets.

# Claude API key — used for compensation inference + role classification.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Sheets sink.
# Service-account JSON — paste the full single-line JSON string. In GH Actions,
# store it in secret GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID of the target sheet (from the URL: docs.google.com/spreadsheets/d/<ID>/...)
GSHEET_ID=

# Optional — for Wellfound scraping (unauthenticated API works for most queries,
# but a session cookie boosts rate limits). Leave blank if unsure.
WELLFOUND_COOKIE=

# Slack sink (added in next session)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
